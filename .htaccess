# =============================================================================
# .htaccess — site-level access rules and response hardening
# =============================================================================
#
# This file is only honored if the server grants AllowOverride for these
# directive groups. If AllowOverride is None, Apache ignores this file
# SILENTLY — the site keeps working and nothing here takes effect. Always
# confirm it is live after deploying (see "Verifying" below) rather than
# assuming it is. Do not treat the presence of this file as protection on
# a host that disables overrides.
#
# Design posture: assume some hosts will not honor .htaccess and may have
# directory listings enabled. Ship only the files the site serves, and drop
# an empty index.html into any directory without one.
#
# The fastest confirmation is a deliberately invalid directive: put a junk
# line in this file and request any page. 500 means Apache reads it; 200
# means it does not. That distinguishes "override disabled" from "rule
# wrong", which the checks below cannot do on their own.
#
# If the site returns 500 after adding this file, AllowOverride permits less
# than this needs. Remove sections from the bottom up; the mod_headers block
# is the least essential.
#
# Verifying (from any machine that can reach the site):
#   curl -o /dev/null -w '%{http_code}\n' https://SITE/README.md      -> 403
#   curl -o /dev/null -w '%{http_code}\n' https://SITE/includes/schema.php -> 403
#   curl -sI https://SITE/index.php | grep -i x-content-type-options   -> present
# A 200 on either of the first two means .htaccess is not in effect.
# =============================================================================


# --- Hidden files and directories --------------------------------------------
# .cursor/, .A_BACKUP/, .git/, .env — anything whose path segment starts with
# a dot. Matches a dot at the start of the request path or right after a slash,
# so ordinary filenames like assets/style.css are unaffected.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F]
</IfModule>


# --- Documentation, notes, schema dumps, compose files -----------------------
# These are repo artifacts, never site content: *.md, *.sql, *.yml.
<FilesMatch "\.(md|sql|ya?ml|log|bak|orig|tmp|dist|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# --- Response hardening ------------------------------------------------------
# Preferred home for these is the vhost; this is the fallback when the vhost
# is not yours to edit.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"

    # 'unsafe-inline' in script-src is required by the site as written: the
    # column picker in report_advanced.php is an inline <script>, and the
    # filter dropdowns use inline onchange="this.form.submit()". Moving both
    # to a file under assets/ would let this drop to "script-src 'self'",
    # which is where the real XSS benefit is. style-src needs no exception —
    # the site has no inline styles, and that restriction is live today.
    # img-src assumes plots (if any) are served from this origin; an absolute
    # plots URL in config.php would need its host added here.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'; object-src 'none'"

    # expose_php is a php.ini setting (PHP_INI_SYSTEM) and cannot be changed
    # from PHP or .htaccess — but the header it produces can be stripped here.
    # PHP writes it into the normal response headers, so the plain (non-
    # "always") form is the one that removes it; the "always" variant covers
    # error responses, where PHP does not set it but a future module might.
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>
