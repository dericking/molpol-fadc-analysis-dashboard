# Deny direct HTTP access to this directory.
#
# docker/ is the local test stack — schema SQL, seed script, compose file.
# It is not deployed to production, so this is a backstop for the case where
# the whole repo tree gets copied to a server anyway.
#
# Honored only if the server grants AllowOverride; see the root .htaccess.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
