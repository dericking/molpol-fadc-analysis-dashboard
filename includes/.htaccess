# Deny direct HTTP access to this directory.
#
# Nothing here is meant to be requested by a browser — these files are
# require'd by the pages in the parent directory. Requesting one directly
# (includes/index_query.php, say) runs it without bootstrap and surfaces a
# PHP error naming absolute server paths.
#
# This only restricts HTTP. PHP's own require/include reads the filesystem
# directly and is unaffected.
#
# Honored only if the server grants AllowOverride; see the root .htaccess.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
